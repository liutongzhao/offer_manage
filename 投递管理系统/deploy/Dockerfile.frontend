# 前端镜像：多阶段构建 —— vite 打包静态文件 + Nginx 托管并反代 API
# 构建上下文是 投递管理系统/ 根目录（compose 里 context: ..）
FROM node:22-alpine AS build

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --registry=https://registry.npmmirror.com || npm install --registry=https://registry.npmmirror.com

COPY frontend/ ./
RUN npm run build        # 产物在 /build/dist

FROM nginx:alpine

# 站点配置：静态文件 + /api 反代后端
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /build/dist /usr/share/nginx/html
EXPOSE 80
