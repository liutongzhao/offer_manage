# 后端环境变量（复制为 backend.env 后按服务器实际填写；此文件不入 git）
# MinIO：容器内部读写走 minio（compose 网络别名）；预签名 URL 走公网地址
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=填你的服务器公网IP:9000
MINIO_ROOT_USER=offer_admin
MINIO_ROOT_PASSWORD=换一个强密码
MINIO_BUCKET=qiuzhao
MINIO_USE_SSL=false

# 数据库：容器内固定路径（compose 挂卷持久化）
SQLITE_PATH=/app/data/app.db

# 跨域：同源部署（Nginx 反代）下前端与 API 同域，无需额外配置
CORS_ORIGINS=http://localhost:5111
